{
  "name": "agent-bazaar",
  "version": "0.5.0",
  "description": "Agent Bazaar — an open, permissionless marketplace and discovery layer for AI agents: APIs, MCP tools, datasets and x402-payable services. Wire-compatible with Coinbase's CDP x402 Bazaar API, no account or KYC required to list. Built by Saylor Innovations.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.test.js && node --test test/db-atomic.test.js",
    "db:init": "wrangler d1 execute open-x402-bazaar --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute open-x402-bazaar --remote --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute open-x402-bazaar --remote --file=migrations/0002_source_and_quality.sql",
    "db:migrate:remote:0003": "wrangler d1 execute open-x402-bazaar --remote --file=migrations/0003_slug_type_metadata.sql",
    "db:migrate:remote:0004": "wrangler d1 execute open-x402-bazaar --remote --file=migrations/0004_liveness.sql",
    "db:migrate:remote:0005": "wrangler d1 execute open-x402-bazaar --remote --file=migrations/0005_agent_registry.sql",
    "db:migrate:remote:0006": "wrangler d1 execute open-x402-bazaar --remote --file=migrations/0006_featured_listings.sql",
    "db:migrate:remote:0007": "wrangler d1 execute open-x402-bazaar --remote --file=migrations/0007_reliability_and_categories.sql",
    "dev": "wrangler pages dev public --compatibility-date=2026-01-01",
    "seed:cdp-bazaar": "node scripts/import-cdp-bazaar.mjs --local",
    "seed:cdp-bazaar:remote": "node scripts/import-cdp-bazaar.mjs --remote --apply",
    "seed:saylor-official": "node scripts/import-saylor-official.mjs --local",
    "seed:saylor-official:remote": "node scripts/import-saylor-official.mjs --remote --apply",
    "check:liveness": "node scripts/check-liveness.mjs --local",
    "check:liveness:remote": "node scripts/check-liveness.mjs --remote --apply"
  },
  "keywords": [
    "x402",
    "agentic-commerce",
    "ai-agents",
    "payments",
    "usdc",
    "bazaar",
    "discovery",
    "http-402",
    "cloudflare-pages",
    "open-source"
  ],
  "author": "Saylor Innovations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaylorInnovations/open-x402-bazaar.git"
  },
  "homepage": "https://github.com/SaylorInnovations/open-x402-bazaar#readme",
  "bugs": {
    "url": "https://github.com/SaylorInnovations/open-x402-bazaar/issues"
  },
  "devDependencies": {
    "wrangler": "^4.134.0"
  },
  "dependencies": {
    "solana-x402": "github:SaylorInnovations/solana-x402#33b8fa0763cefd1e3a98e9d1b8e5e097ad49ea87"
  }
}
